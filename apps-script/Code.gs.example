/**
 * PIOT Analytics — Google Apps Script backend.
 * Подключает интерфейс к листам:
 *   Заявка
 *   Отсутствует задача ЕСП
 *   Суммы
 *
 * Перед использованием проверьте права доступа к проекту и таблице.
 */

var PIOT_SPREADSHEET_ID = 'https://script.google.com/macros/s/AKfycbyyuRVGYhYEjW8rdmfsu7g1Yjc7aVB8af5BLCMSV2UQwG7KVqWhZNG-xvbKbZMm1wbt/exec';

var PIOT_SHEET_MAIN = 'Заявка';
var PIOT_SHEET_NO_ESP = 'Отсутствует задача ЕСП';
var PIOT_SHEET_SUMS = 'Суммы';
var PIOT_CONFIG_PROPERTY = 'PIOT_ANALYTICS_CONFIG_V1';

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Панель PIOT')
    .addItem('Открыть панель', 'showDashboard')
    .addToUi();
}

function showDashboard() {
  SpreadsheetApp.getUi().showModelessDialog(
    buildPiotHtml_().setWidth(1400).setHeight(900),
    'Панель PIOT'
  );
}

function doGet(e) {
  return HtmlService.createHtmlOutputFromFile('PiotBridge')
    .setTitle('PIOT Analytics connection')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function buildPiotHtml_() {
  // Весь интерфейс (CSS + Piot + App) уже встроен в один Index.html.
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('ТС ПИОТ · Аналитика');
}

function getPiotSpreadsheet_() {
  try {
    return SpreadsheetApp.openById(https://script.google.com/macros/s/AKfycbyyuRVGYhYEjW8rdmfsu7g1Yjc7aVB8af5BLCMSV2UQwG7KVqWhZNG-xvbKbZMm1wbt/exec);
  } catch (err) {
    throw new Error('Не удалось открыть Google Таблицу. Проверьте ID и права доступа: ' + err.message);
  }
}

function getPiotSheet_(name) {
  var sheet = getPiotSpreadsheet_().getSheetByName(name);
  if (!sheet) throw new Error('В таблице не найден лист «' + name + '».');
  return sheet;
}

function normalizeHeader_(value) {
  return String(value == null ? '' : value)
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/\s+/g, ' ')
    .trim();
}

function findHeaderIndex_(headers, aliases, required) {
  var normalized = headers.map(normalizeHeader_);
  for (var i = 0; i < aliases.length; i++) {
    var wanted = normalizeHeader_(aliases[i]);
    var index = normalized.indexOf(wanted);
    if (index !== -1) return index;
  }
  if (required) {
    throw new Error('Не найден столбец: ' + aliases[0] + '. Проверьте строку заголовков листа.');
  }
  return -1;
}

function getCellText_(displayRow, valueRow, index) {
  if (index < 0) return '';
  var shown = displayRow[index];
  if (shown !== '' && shown != null) return String(shown).trim();
  var raw = valueRow[index];
  if (raw == null || raw === '') return '';
  if (raw instanceof Date && !isNaN(raw.getTime())) {
    return Utilities.formatDate(raw, getPiotSpreadsheet_().getSpreadsheetTimeZone(), 'dd.MM.yyyy HH:mm');
  }
  return String(raw).trim();
}

function parsePiotAmount_(value) {
  if (value == null || value === '') return 0;
  if (typeof value === 'number') {
    return isFinite(value) ? Math.round(value * 100) / 100 : 0;
  }

  var s = String(value)
    .replace(/(?:руб\.?|₽|RUB)/gi, '')
    .replace(/[\s\u00a0\u202f]/g, '')
    .replace(/[^\d,.\-]/g, '');

  if (!s || s === '-' || s === ',' || s === '.') return 0;

  var comma = s.lastIndexOf(',');
  var dot = s.lastIndexOf('.');
  if (comma !== -1 && dot !== -1) {
    if (comma > dot) {
      s = s.replace(/\./g, '').replace(',', '.');
    } else {
      s = s.replace(/,/g, '');
    }
  } else if (comma !== -1) {
    s = s.replace(',', '.');
  } else if ((s.match(/\./g) || []).length > 1) {
    s = s.replace(/\./g, '');
  }

  var result = Number(s);
  return isFinite(result) ? Math.round(result * 100) / 100 : 0;
}

function parsePiotDate_(raw, display, timeZone) {
  if (raw instanceof Date && !isNaN(raw.getTime())) {
    return Utilities.formatDate(raw, timeZone, 'yyyy-MM-dd');
  }

  var s = String(display || raw || '').trim();
  if (!s) return '';

  var iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return iso[1] + '-' + iso[2] + '-' + iso[3];

  var ru = s.match(/^(\d{1,2})[./-](\d{1,2})[./-](\d{2,4})/);
  if (ru) {
    var day = Number(ru[1]);
    var month = Number(ru[2]);
    var year = Number(ru[3]);
    if (year < 100) year += 2000;
    if (month >= 1 && month <= 12 && day >= 1 && day <= 31) {
      return String(year) + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
    }
  }
  return '';
}

function parsePiotMonth_(raw, display, timeZone) {
  if (raw instanceof Date && !isNaN(raw.getTime())) {
    return Utilities.formatDate(raw, timeZone, 'yyyy-MM');
  }
  var s = String(display || raw || '').trim();
  if (/^\d{4}-(0[1-9]|1[0-2])$/.test(s)) return s;
  var d = parsePiotDate_(raw, display, timeZone);
  return d ? d.slice(0, 7) : '';
}

function readPiotMainRecords_(spreadsheet) {
  var sheet = spreadsheet.getSheetByName(PIOT_SHEET_MAIN);
  if (!sheet) throw new Error('Не найден лист «' + PIOT_SHEET_MAIN + '».');

  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return [];

  var header = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var cols = {
    numero: findHeaderIndex_(header, ['Номер'], true),
    partner: findHeaderIndex_(header, ['Сервис Партнер', 'Сервис Партнёр'], true),
    client: findHeaderIndex_(header, ['Клиент'], true),
    status: findHeaderIndex_(header, ['Статус'], true),
    taskStatus: findHeaderIndex_(header, ['Статус передачи задачи'], true),
    amount: findHeaderIndex_(header, ['Сумма платной установки ТС Пиот'], true),
    responsible: findHeaderIndex_(header, ['Ответственный'], true),
    priority: findHeaderIndex_(header, ['Приоритет'], true),
    date: findHeaderIndex_(header, ['Дата создания'], true),
    dateStatus: findHeaderIndex_(header, ['Дата статуса'], true),
    sla: findHeaderIndex_(header, ['SLA'], false),
    customer: findHeaderIndex_(header, ['Заказчик'], true),
    legalEntity: findHeaderIndex_(header, ['Юридическое лицо', 'Юр. лицо'], true)
  };

  var maxCol = Math.max.apply(null, Object.keys(cols).map(function (k) { return cols[k]; })) + 1;
  var range = sheet.getRange(1, 1, lastRow, maxCol);
  var values = range.getValues();
  var display = range.getDisplayValues();
  var timeZone = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Moscow';
  var records = [];

  for (var r = 1; r < values.length; r++) {
    var v = values[r];
    var d = display[r];
    var numero = getCellText_(d, v, cols.numero);
    var client = getCellText_(d, v, cols.client);
    var partner = getCellText_(d, v, cols.partner);
    var customer = getCellText_(d, v, cols.customer);
    var legalEntity = getCellText_(d, v, cols.legalEntity);
    if (!numero && !client && !partner && !customer && !legalEntity) continue;

    var amountRaw = cols.amount >= 0 ? v[cols.amount] : '';
    var amountDisplay = cols.amount >= 0 ? d[cols.amount] : '';
    records.push({
      numero: numero,
      partner: partner,
      client: client,
      status: getCellText_(d, v, cols.status),
      taskStatus: getCellText_(d, v, cols.taskStatus),
      amount: parsePiotAmount_(typeof amountRaw === 'number' ? amountRaw : (amountDisplay || amountRaw)),
      responsible: getCellText_(d, v, cols.responsible),
      priority: getCellText_(d, v, cols.priority),
      date: parsePiotDate_(v[cols.date], d[cols.date], timeZone),
      dateStatus: parsePiotDate_(v[cols.dateStatus], d[cols.dateStatus], timeZone),
      sla: getCellText_(d, v, cols.sla),
      customer: customer,
      legalEntity: legalEntity,
      source: 'main'
    });
  }
  return records;
}

function readPiotNoEspRecords_(spreadsheet) {
  var sheet = spreadsheet.getSheetByName(PIOT_SHEET_NO_ESP);
  if (!sheet) return [];

  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return [];

  var header = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var cols = {
    organization: findHeaderIndex_(header, ['Наименование организации (ООО/ИП)', 'Наименование организации'], true),
    contact: findHeaderIndex_(header, ['Контактное лицо (ФИО)', 'Контактное лицо'], false),
    amount: findHeaderIndex_(header, ['Сумма'], true),
    date: findHeaderIndex_(header, ['Дата', 'Дата создания'], false)
  };
  var maxCol = Math.max(cols.organization, cols.contact, cols.amount, cols.date) + 1;
  var range = sheet.getRange(1, 1, lastRow, maxCol);
  var values = range.getValues();
  var display = range.getDisplayValues();
  var timeZone = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Moscow';
  var records = [];

  for (var r = 1; r < values.length; r++) {
    var v = values[r];
    var d = display[r];
    var organization = getCellText_(d, v, cols.organization);
    var contact = getCellText_(d, v, cols.contact);
    var amountRaw = cols.amount >= 0 ? v[cols.amount] : '';
    var amountDisplay = cols.amount >= 0 ? d[cols.amount] : '';
    var amount = parsePiotAmount_(typeof amountRaw === 'number' ? amountRaw : (amountDisplay || amountRaw));
    if (!organization && !contact && !amount) continue;

    records.push({
      numero: 'ЕСП-' + (r + 1),
      partner: 'LIFE PAY',
      client: organization || contact,
      status: '',
      taskStatus: '',
      amount: amount,
      responsible: '',
      priority: '',
      date: cols.date >= 0 ? parsePiotDate_(v[cols.date], d[cols.date], timeZone) : '',
      dateStatus: '',
      sla: '',
      customer: organization,
      legalEntity: organization,
      contact: contact,
      source: 'noesp'
    });
  }
  return records;
}

function findSumColumns_(headers) {
  return {
    month: findHeaderIndex_(headers, ['Месяц'], true),
    plan: findHeaderIndex_(headers, ['План'], true),
    done: findHeaderIndex_(headers, ['Выполнено вручную'], true),
    closed: findHeaderIndex_(headers, ['Закрыто вручную'], true),
    sp: findHeaderIndex_(headers, ['Доход СП вручную'], true),
    esp: findHeaderIndex_(headers, ['Доход ЕСП'], true),
    autoTotal: findHeaderIndex_(headers, ['Всего авто'], false),
    autoDone: findHeaderIndex_(headers, ['Выполнено авто'], false),
    autoClosed: findHeaderIndex_(headers, ['Закрыто авто'], false),
    autoRevenue: findHeaderIndex_(headers, ['Выручка авто'], false),
    autoSp: findHeaderIndex_(headers, ['Доход СП авто'], false),
    updated: findHeaderIndex_(headers, ['Обновлено вручную'], false),
    autoUpdated: findHeaderIndex_(headers, ['Обновлено авто'], false),
    revision: findHeaderIndex_(headers, ['Версия'], true)
  };
}

function numberOrNull_(value) {
  if (value == null || value === '') return null;
  var n = parsePiotAmount_(value);
  return isFinite(n) ? n : null;
}

function numberOrZero_(value) {
  var n = numberOrNull_(value);
  return n == null ? 0 : n;
}

function timestampValue_(raw, display) {
  if (raw instanceof Date && !isNaN(raw.getTime())) return raw.toISOString();
  return String(display || raw || '');
}

function ledgerEntryFromRow_(values, display, cols) {
  function val(key) {
    return cols[key] >= 0 ? values[cols[key]] : '';
  }
  function shown(key) {
    return cols[key] >= 0 ? display[cols[key]] : '';
  }
  return {
    plan: numberOrNull_(val('plan')),
    done: numberOrNull_(val('done')),
    closed: numberOrNull_(val('closed')),
    sp: numberOrNull_(val('sp')),
    esp: numberOrNull_(val('esp')),
    revision: Math.max(0, parseInt(val('revision'), 10) || 0),
    updated: timestampValue_(val('updated'), shown('updated')),
    auto: {
      total: numberOrZero_(val('autoTotal')),
      done: numberOrZero_(val('autoDone')),
      closed: numberOrZero_(val('autoClosed')),
      revenue: numberOrZero_(val('autoRevenue')),
      sp: numberOrZero_(val('autoSp'))
    },
    autoUpdated: timestampValue_(val('autoUpdated'), shown('autoUpdated'))
  };
}

function readPiotLedger_(spreadsheet) {
  var sheet = spreadsheet.getSheetByName(PIOT_SHEET_SUMS);
  if (!sheet) throw new Error('Не найден лист «' + PIOT_SHEET_SUMS + '».');

  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  var ledger = {};
  if (lastRow < 2 || lastCol < 1) return ledger;

  var header = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var cols = findSumColumns_(header);
  var range = sheet.getRange(1, 1, lastRow, lastCol);
  var values = range.getValues();
  var display = range.getDisplayValues();
  var timeZone = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Moscow';

  for (var r = 1; r < values.length; r++) {
    var month = parsePiotMonth_(values[r][cols.month], display[r][cols.month], timeZone);
    if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) continue;
    ledger[month] = ledgerEntryFromRow_(values[r], display[r], cols);
  }
  return ledger;
}

function defaultPiotConfig_() {
  return {
    revision: 0,
    animate: true,
    showBanks: true,
    showCharts: true,
    showStatuses: true,
    perPage: 25,
    noEspDateCol: 0,
    done: ['закрыта', 'закрыто', 'завершена', 'завершено', 'выполнена', 'выполнено', 'выполнен', 'задача выполнена', 'задача выполнина', 'установлен', 'готово', 'оплачено у lp', 'клиент настроен с нашей помощью', 'клиент сам установил'],
    closed: ['закрыта', 'закрыто', 'завершена', 'завершено'],
    invoice: ['счет отправил', 'выставлен счет'],
    lp: ['в работе у сп', 'оплачено у lp', 'задача выполнена: клиент оплатил lp', 'в работе у lp', 'клиент оплатил lp', 'оплатил лп', 'оплачено лп', 'в работе у лп', 'клиент настроен с нашей помощью', 'задачу направил в отдел ордк'],
    sp: ['задача выполнена: клиент оплатил сп', 'в работе клиент оплатил сп', 'клиент оплатил сп', 'оплатил сп', 'сп оплат'],
    bankKeys: [
      ['втб', 'vtb', 'бм-банк'],
      ['альфа', 'alfa', 'alpha'],
      ['точка', 'tochka'],
      ['псб', 'psb', 'промсвязьбанк']
    ]
  };
}

function validatePiotConfig_(raw) {
  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
    throw new Error('Неверный формат настроек.');
  }
  var base = defaultPiotConfig_();
  var out = {};
  var boolKeys = ['animate', 'showBanks', 'showCharts', 'showStatuses'];
  boolKeys.forEach(function (key) {
    var value = raw[key] === undefined ? base[key] : raw[key];
    if (typeof value !== 'boolean') throw new Error('Неверное значение настройки ' + key + '.');
    out[key] = value;
  });

  var perPage = raw.perPage === undefined ? base.perPage : Number(raw.perPage);
  if ([10, 25, 50, 100].indexOf(perPage) === -1) throw new Error('Размер страницы должен быть 10, 25, 50 или 100.');
  out.perPage = perPage;

  var noEspDateCol = raw.noEspDateCol === undefined ? base.noEspDateCol : Number(raw.noEspDateCol);
  if (!Number.isInteger(noEspDateCol) || noEspDateCol < 0 || noEspDateCol > 50) {
    throw new Error('Номер столбца даты должен быть от 0 до 50.');
  }
  out.noEspDateCol = noEspDateCol;

  ['done', 'closed', 'invoice', 'lp', 'sp'].forEach(function (key) {
    var list = raw[key] === undefined ? base[key] : raw[key];
    if (!Array.isArray(list) || list.length > 80) throw new Error('Неверный список правил: ' + key);
    out[key] = [];
    list.forEach(function (item) {
      if (typeof item !== 'string' || item.length > 180) throw new Error('Неверное правило в списке ' + key);
      var normalized = normalizeHeader_(item);
      if (normalized && out[key].indexOf(normalized) === -1) out[key].push(normalized);
    });
  });

  var bankKeys = raw.bankKeys === undefined ? base.bankKeys : raw.bankKeys;
  if (!Array.isArray(bankKeys) || bankKeys.length !== 4) throw new Error('Нужно указать ключи для четырёх банков.');
  out.bankKeys = bankKeys.map(function (list) {
    if (!Array.isArray(list) || list.length > 30) throw new Error('Неверный список ключей банка.');
    var result = [];
    list.forEach(function (item) {
      if (typeof item !== 'string' || item.length > 80) throw new Error('Неверный ключ банка.');
      var normalized = normalizeHeader_(item);
      if (normalized && result.indexOf(normalized) === -1) result.push(normalized);
    });
    return result;
  });

  out.revision = Math.max(0, parseInt(raw.revision, 10) || 0);
  return out;
}

function readPiotConfig_() {
  var properties = PropertiesService.getScriptProperties();
  var raw = properties.getProperty(PIOT_CONFIG_PROPERTY);
  if (!raw) return defaultPiotConfig_();
  try {
    return validatePiotConfig_(JSON.parse(raw));
  } catch (err) {
    console.error('PIOT config reset to defaults: ' + err.message);
    return defaultPiotConfig_();
  }
}

function apiGetData() {
  var spreadsheet = getPiotSpreadsheet_();
  var records = readPiotMainRecords_(spreadsheet);
  records = records.concat(readPiotNoEspRecords_(spreadsheet));

  var ledger = readPiotLedger_(spreadsheet);
  var timeZone = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Moscow';
  var currentMonth = Utilities.formatDate(new Date(), timeZone, 'yyyy-MM');
  var monthSet = {};
  Object.keys(ledger).forEach(function (month) { monthSet[month] = true; });
  records.forEach(function (record) {
    [record.date, record.dateStatus].forEach(function (date) {
      var month = String(date || '').slice(0, 7);
      if (/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) monthSet[month] = true;
    });
  });
  monthSet[currentMonth] = true;

  return {
    records: records,
    ledger: ledger,
    config: readPiotConfig_(),
    months: Object.keys(monthSet).sort(),
    currentMonth: currentMonth,
    updated: new Date().toISOString(),
    demo: false
  };
}

function validatePiotPatch_(patch) {
  if (!patch || typeof patch !== 'object' || Array.isArray(patch)) {
    throw new Error('Неверные данные для сохранения.');
  }
  var allowed = ['plan', 'done', 'closed', 'sp', 'esp'];
  var result = {};
  Object.keys(patch).forEach(function (key) {
    if (allowed.indexOf(key) === -1) throw new Error('Неизвестное поле: ' + key);
    var value = patch[key];
    if (value === null || value === '') {
      result[key] = null;
      return;
    }
    if (typeof value !== 'number' || !isFinite(value) || value < 0 || value > 1000000000000) {
      throw new Error('Поле ' + key + ': введите неотрицательное число.');
    }
    if (['plan', 'done', 'closed'].indexOf(key) !== -1 && Math.floor(value) !== value) {
      throw new Error('Поле ' + key + ': количество должно быть целым.');
    }
    result[key] = Math.round(value * 100) / 100;
  });
  return result;
}

function apiSaveMonth(arg) {
  if (!arg || !/^\d{4}-(0[1-9]|1[0-2])$/.test(String(arg.month || ''))) {
    throw new Error('Выберите корректный месяц.');
  }
  var patch = validatePiotPatch_(arg.patch);
  var incomingRevision = Math.max(0, parseInt(arg.revision, 10) || 0);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var sheet = getPiotSheet_(PIOT_SHEET_SUMS);
    var lastCol = sheet.getLastColumn();
    if (lastCol < 1) throw new Error('На листе «Суммы» нет заголовков.');
    var headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
    var cols = findSumColumns_(headers);
    var lastRow = sheet.getLastRow();
    var rowNumber = 0;

    if (lastRow >= 2) {
      var months = sheet.getRange(2, cols.month + 1, lastRow - 1, 1).getDisplayValues();
      for (var i = 0; i < months.length; i++) {
        if (String(months[i][0]).trim() === arg.month) {
          rowNumber = i + 2;
          break;
        }
      }
    }

    var currentRevision = 0;
    if (rowNumber) {
      currentRevision = Math.max(0, parseInt(sheet.getRange(rowNumber, cols.revision + 1).getValue(), 10) || 0);
    }

    if (currentRevision !== incomingRevision) {
      throw new Error('CONFLICT: месяц уже изменён в другом окне. Обновите данные и повторите ввод.');
    }

    if (!rowNumber) {
      rowNumber = Math.max(2, sheet.getLastRow() + 1);
      sheet.getRange(rowNumber, cols.month + 1).setValue(arg.month);
    }

    var fieldColumns = {
      plan: cols.plan,
      done: cols.done,
      closed: cols.closed,
      sp: cols.sp,
      esp: cols.esp
    };
    Object.keys(patch).forEach(function (key) {
      var column = fieldColumns[key];
      if (column == null || column < 0) throw new Error('На листе «Суммы» не найден столбец для ' + key + '.');
      var cell = sheet.getRange(rowNumber, column + 1);
      if (patch[key] === null) cell.clearContent();
      else cell.setValue(patch[key]);
    });

    var nextRevision = currentRevision + 1;
    sheet.getRange(rowNumber, cols.revision + 1).setValue(nextRevision);
    if (cols.updated >= 0) sheet.getRange(rowNumber, cols.updated + 1).setValue(new Date());
    SpreadsheetApp.flush();

    var rowRange = sheet.getRange(rowNumber, 1, 1, sheet.getLastColumn());
    var values = rowRange.getValues()[0];
    var display = rowRange.getDisplayValues()[0];
    return { value: ledgerEntryFromRow_(values, display, cols) };
  } finally {
    lock.releaseLock();
  }
}

function apiSaveConfig(arg) {
  if (!arg || !arg.config) throw new Error('Не переданы настройки.');
  var incomingRevision = Math.max(0, parseInt(arg.revision, 10) || 0);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var current = readPiotConfig_();
    if (incomingRevision !== current.revision) {
      throw new Error('CONFLICT: настройки изменены в другом окне. Обновите страницу.');
    }
    var next = validatePiotConfig_(arg.config);
    next.revision = current.revision + 1;
    PropertiesService.getScriptProperties().setProperty(PIOT_CONFIG_PROPERTY, JSON.stringify(next));
    return next;
  } finally {
    lock.releaseLock();
  }
}

/** Проверка соединения: можно запустить вручную из редактора Apps Script. */
function testPiotConnection() {
  var data = apiGetData();
  var result = {
    spreadsheet: PIOT_SPREADSHEET_ID,
    records: data.records.length,
    mainRecords: data.records.filter(function (r) { return r.source === 'main'; }).length,
    noEspRecords: data.records.filter(function (r) { return r.source === 'noesp'; }).length,
    months: data.months.length,
    currentMonth: data.currentMonth,
    demo: data.demo
  };
  Logger.log(JSON.stringify(result, null, 2));
  return result;
}
